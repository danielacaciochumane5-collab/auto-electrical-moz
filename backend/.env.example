# AUTO ELECTRICAL MOZ - Configurações do Ambiente

# Database
DATABASE_URL=sqlite:///autoelectrical.db
# Para produção usar PostgreSQL: postgresql://user:password@localhost/db_name

# Email Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=seu_email@gmail.com
MAIL_PASSWORD=sua_senha_app
MAIL_DEFAULT_SENDER=contacto@autoelectricalmoz.com

# WhatsApp Business API (Twilio)
TWILIO_ACCOUNT_SID=seu_account_sid
TWILIO_AUTH_TOKEN=seu_auth_token
TWILIO_WHATSAPP_NUMBER=+14155552671

# Flask
FLASK_ENV=development
FLASK_DEBUG=True

# Analytics
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# API Keys
SECRET_KEY=sua_chave_secreta_super_segura_aqui
